{
  "name": "previred-downloader-desktop",
  "version": "0.1.0",
  "description": "Cliente de escritorio para descargar planillas desde Previred.",
  "author": "Previred Downloader",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:config": "node scripts/write-build-config.js",
    "build:ui": "vite build",
    "prepare:runtime": "node scripts/prepare-python-runtime.js",
    "preview": "vite preview",
    "pack": "npm run build:config && npm run build:ui && electron-builder --dir",
    "pack:full": "npm run build:config && npm run build:ui && npm run prepare:runtime && electron-builder --dir",
    "dist": "npm run build:config && npm run build:ui && npm run prepare:runtime && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "cl.previred.downloader",
    "productName": "Previred Downloader",
    "icon": "build/icon",
    "asar": true,
    "files": [
      "src/**/*",
      "dist-ui/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "app",
        "filter": [
          "bot/**",
          "desktop_backend/**",
          "checkpoint.py",
          "models.py",
          "zip_builder.py",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "python-runtime",
        "to": "python-runtime",
        "filter": ["**/*"]
      },
      {
        "from": "ms-playwright",
        "to": "ms-playwright",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "Previred-Downloader-Setup-${version}.${ext}",
      "target": ["nsis"]
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Previred Downloader"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LuN4t1k0",
        "repo": "RPA-PREVIRED",
        "releaseType": "release"
      }
    ]
  }
}
